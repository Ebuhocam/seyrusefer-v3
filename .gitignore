# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# orijinal yuksek cozunurluklu gorseller (scripts/gorsel-optimize.mjs ile public'e donusturulur)
/_kaynak-gorseller/

# cloudflare / opennext
/.wrangler/
/.open-next/

# elle yayın paketi ve eski bun kilit dosyası (Cloudflare otomatik derlemesi npm kullanır)
/open-next-paketi.zip
/bun.lock.eski

# tanıtım filmi çıktı ve geçici ses dosyaları (Cloudflare asset limitini ve depoyu şişirmesin)
/tanitim_filmi*.mp4
/seslendirme.*
/muzik.*
