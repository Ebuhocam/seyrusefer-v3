{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seyrusefer-v3",
  // OpenNext Worker'ını saran dosya: günlük bildirim zamanlayıcısını (scheduled) ekler
  "main": "custom-worker.js",
  "triggers": {
    // Her gün 13:30 UTC = 16:30 Türkiye saati (günlük hatırlatma bildirimi)
    "crons": ["30 13 * * *"]
  },
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Site seyrusefer.org ve www.seyrusefer.org adreslerinde yayınlanır (alan adı Cloudflare'de)
  "routes": [
    { "pattern": "seyrusefer.org", "custom_domain": true },
    { "pattern": "www.seyrusefer.org", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "seyrusefer-v3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seyrusefer-v3-db",
      "database_id": "e23293e1-7e9a-4ce1-b319-6fe0eec32a45",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "seyrusefer-medya"
    }
  ]
}
